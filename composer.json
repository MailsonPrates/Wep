{
    "name": "wep/framework",
    "description": "Micro framework PHP para aplicações web com front em React",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mailson Prates",
            "email": "mailsonprates@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "pestphp/pest": "^2.36 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
